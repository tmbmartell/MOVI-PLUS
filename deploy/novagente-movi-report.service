[Unit]
Description=MOVI+ resumo financeiro autorizado (piloto, envios opt-in)
After=network-online.target novagente-clube-motorista-v5.service
Wants=network-online.target

[Service]
Type=oneshot
User=sentinelx
Group=sentinelx
WorkingDirectory=/srv/clube-motorista-v3/financeiro-secure-v5
Environment=PYTHONDONTWRITEBYTECODE=1
Environment=CLUBE_DATA=/srv/clube-motorista-v3/financeiro-secure-v5/data
Environment=MOVI_REPORT_DELIVERY_ENABLED=0
EnvironmentFile=-/etc/novagente/movi-report.env
ExecStart=/srv/clube-motorista-v3/financeiro-secure-v5/.venv/bin/python -m finance_auto_report_v1 --send
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/srv/clube-motorista-v3/financeiro-secure-v5/data
UMask=0077
TimeoutStartSec=120
